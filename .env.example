# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Admin Security PIN (Used to access the Admin Control Center)
ADMIN_PIN=123456

# Base Application URL (Used for generating client share links)
