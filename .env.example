# Google Sheets Spreadsheet ID (Optional: override default Google Sheet)
SPREADSHEET_ID="1NqVnp2VLJ0Hgd2-sbYHCtSqmi3udjeFjOHD-wCDGDbA"

# Google Cloud Service Account JSON (Optional: required for live Google Sheets sync)
# Provide the full single-line JSON string or save a 'service_account.json' file in the root folder.
